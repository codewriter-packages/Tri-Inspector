.tri-button {
    margin: 1px -2px 1px 3px;
    white-space: normal;
}

.tri-button__box {
    margin: 1px -2px 1px 3px;
    padding: 2px 5px 2px 2px;
    border-width: 1px;
    border-color: var(--tri-color-border);
    border-radius: 3px;
}

.tri-button__box > .tri-button {
    margin: -3px -6px 3px -3px;
}
